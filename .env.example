# Use o nome desta variável no nó "Agente LLM".
OPENAI_API_KEY=

# Obrigatórios/recomendados em produção com Docker Compose.
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
SESSION_SECRET=gere-uma-string-aleatoria-longa
COOKIE_SECURE=false
AGENTIC_FLOW_PORT=8000

# Alternativa ao Compose: conexão completa com um MySQL externo.
# DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/agentic_flow?charset=utf8mb4

# Opcional para desenvolvimento sem Docker (SQLite).
# AGENTIC_FLOW_DATA_DIR=./data
