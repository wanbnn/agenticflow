# Recomendados em produção. O banco interno é sempre SQLite.
SESSION_SECRET=gere-uma-string-aleatoria-longa
CREDENTIALS_ENCRYPTION_KEY=gere-outra-string-aleatoria-longa
COOKIE_SECURE=false
AGENTIC_FLOW_PORT=16777
AGENTIC_FLOW_MAX_ASSET_MB=1000
HF_HOME=./data/huggingface
AGENTIC_FLOW_MODEL_DIR=./data/models
AGENTIC_FLOW_MODEL_IDLE_SECONDS=60
# Opcional: force hip, cuda, vulkan ou cpu para modelos GGUF.
# AGENTIC_FLOW_LLAMA_CPP_BACKEND=hip
# AGENTIC_FLOW_DISABLE_LLAMA_CPP=1

# Caminho opcional para o SQLite interno e diretório de modelos/cache.
# AGENTIC_FLOW_SQLITE_PATH=./data/agentic-flow-v2.db
# AGENTIC_FLOW_DATA_DIR=./data
